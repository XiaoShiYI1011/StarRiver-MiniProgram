{
  "name": "novel-writing-assistant-uniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:mp-weixin": "node scripts/build-local.cjs mp-weixin",
    "build:h5": "node scripts/build-local.cjs h5",
    "test:mock": "node --test tests/mockStudioService.test.cjs",
    "test:auth": "node --test tests/miniAuthClient.test.cjs",
    "lint": "npm run lint:eslint && npm run lint:stylelint && npm run lint:prettier && npm run lint:scss-structure",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check \"**/*.{js,cjs,mjs,vue,css,scss}\" \"*.html\"",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:scss-structure": "node scripts/check-scss-structure.cjs",
    "lint:lint-staged": "lint-staged",
    "type-check": "vue-tsc --noEmit",
    "test:layout": "node --test tests/pageMetrics.test.cjs"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,mjs}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "^3.0.0-alpha-5020520260829001",
    "@eslint/js": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vue/shared": "3.4.21",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^15.11.0",
    "lint-staged": "^15.2.10",
    "postcss-html": "^1.7.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "~5.7.3",
    "vue": "3.4.21",
    "vue-tsc": "^2.2.0"
  }
}
